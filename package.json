{
  "name": "banglaclaw",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "tsx --conditions=@banglaclaw/source apps/cli/src/index.ts chat",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "banglaclaw": "tsx --conditions=@banglaclaw/source apps/cli/src/index.ts",
    "audit:deps": "pnpm audit --audit-level high",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && bash scripts/pack-smoke.sh && changeset publish",
    "verify:pack": "bash scripts/pack-smoke.sh",
    "e2e": "pnpm --filter @entrogic-net/e2e e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
