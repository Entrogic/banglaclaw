{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "outputs": [],
      "passThroughEnv": [
        "TEST_DATABASE_URL"
      ]
    },
    "typecheck": {
      "outputs": []
    }
  }
}
