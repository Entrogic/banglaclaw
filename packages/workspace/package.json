{
  "name": "@entrogic-net/workspace",
  "version": "1.4.0",
  "description": "Sandboxed per-owner workspace and file tools for BanglaClaw agents (create, edit, undo)",
  "keywords": [
    "banglaclaw",
    "bangla",
    "bengali",
    "banglish",
    "ai-agent",
    "workspace",
    "files",
    "tools",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "author": "Entrogic",
  "homepage": "https://github.com/Entrogic/banglaclaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entrogic/banglaclaw.git",
    "directory": "packages/workspace"
  },
  "bugs": {
    "url": "https://github.com/Entrogic/banglaclaw/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "@banglaclaw/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@entrogic-net/session": "workspace:*",
    "@entrogic-net/shared": "workspace:*",
    "@entrogic-net/tools": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@entrogic-net/agent": "workspace:*",
    "@entrogic-net/providers": "workspace:*"
  }
}
