{
  "name": "@banglaclaw/agent",
  "version": "1.2.0",
  "description": "LangGraph agent runtime for BanglaClaw: runs, limits, streaming events and multi-agent teams",
  "keywords": [
    "banglaclaw",
    "bangla",
    "bengali",
    "banglish",
    "ai-agent",
    "agent",
    "langgraph",
    "runtime"
  ],
  "license": "Apache-2.0",
  "author": "Entrogic",
  "homepage": "https://github.com/Entrogic/banglaclaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entrogic/banglaclaw.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/Entrogic/banglaclaw/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "@banglaclaw/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@banglaclaw/providers": "workspace:*",
    "@banglaclaw/shared": "workspace:*",
    "@banglaclaw/skills": "workspace:*",
    "@banglaclaw/tools": "workspace:*",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@opentelemetry/api": "^1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@banglaclaw/agents": "workspace:*",
    "@banglaclaw/session": "workspace:*",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0"
  }
}
