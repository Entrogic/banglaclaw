{
  "name": "@entrogic-net/storage",
  "version": "1.2.0",
  "description": "PostgreSQL storage for BanglaClaw (Drizzle): sessions, runs, keys, audit and checkpoints",
  "keywords": [
    "banglaclaw",
    "bangla",
    "bengali",
    "banglish",
    "ai-agent",
    "postgres",
    "drizzle",
    "storage"
  ],
  "license": "Apache-2.0",
  "author": "Entrogic",
  "homepage": "https://github.com/Entrogic/banglaclaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entrogic/banglaclaw.git",
    "directory": "packages/storage"
  },
  "bugs": {
    "url": "https://github.com/Entrogic/banglaclaw/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "@banglaclaw/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@entrogic-net/session": "workspace:*",
    "@entrogic-net/shared": "workspace:*",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@entrogic-net/agent": "workspace:*",
    "@entrogic-net/auth": "workspace:*",
    "@entrogic-net/providers": "workspace:*",
    "@entrogic-net/tools": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
