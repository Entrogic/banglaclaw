# Provider: openai-compatible | anthropic
BANGLACLAW_PROVIDER=openai-compatible
BANGLACLAW_MODEL=gpt-4o-mini
# Optional base URL for OpenAI-compatible servers (DeepSeek, OpenRouter, vLLM, Ollama http://localhost:11434/v1)
BANGLACLAW_BASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage: memory (default) | postgres
BANGLACLAW_STORAGE=memory
# Required for postgres storage (docker/compose.yaml defaults shown)
DATABASE_URL=postgres://banglaclaw:banglaclaw@localhost:54329/banglaclaw
# Integration tests only — a dedicated database whose tables get truncated
TEST_DATABASE_URL=postgres://banglaclaw:banglaclaw@localhost:54329/banglaclaw_test

# Channels (banglaclaw serve)
# TELEGRAM_BOT_TOKEN=123456:ABC...          # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=                  # webhook mode only; 16+ chars of A-Z a-z 0-9 _ -
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# MESSENGER_PAGE_ACCESS_TOKEN=               # Facebook page access token
# MESSENGER_APP_SECRET=                      # Meta app secret (verifies webhooks)
# MESSENGER_VERIFY_TOKEN=                    # any string; also entered in the Meta app dashboard

# Knowledge / long-term memory
# QDRANT_URL=http://localhost:56333
# QDRANT_API_KEY=
# EMBEDDINGS_API_KEY=                       # defaults to OPENAI_API_KEY
# TRANSCRIPTION_API_KEY=                    # voice notes; defaults to OPENAI_API_KEY
# TEST_QDRANT_URL=http://localhost:56333   # enables Qdrant integration tests

# Human handoff notifications (POST JSON {event, sessionId, channel, reason, at})
# HANDOFF_WEBHOOK_URL=

# Website widget (docs/11): signs visitor tokens; generate with `openssl rand -hex 32`
# BANGLACLAW_WIDGET_SECRET=

# Observability (docs/15)
# METRICS_TOKEN=                             # bearer token for GET /metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Docker compose (docker/compose.prod.yaml)
# POSTGRES_PASSWORD=

# Gateway overrides (banglaclaw serve)
# BANGLACLAW_GATEWAY_PORT=3000
# BANGLACLAW_GATEWAY_HOST=127.0.0.1

# debug | info | warn | error
BANGLACLAW_LOG_LEVEL=warn
