{
  "name": "@entrogic-net/cli",
  "version": "1.6.0",
  "description": "BanglaClaw command-line interface: terminal chat, gateway server, setup wizard and admin commands",
  "keywords": [
    "banglaclaw",
    "bangla",
    "bengali",
    "banglish",
    "ai-agent",
    "cli",
    "chat",
    "tui"
  ],
  "license": "Apache-2.0",
  "author": "Entrogic",
  "homepage": "https://github.com/Entrogic/banglaclaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entrogic/banglaclaw.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/Entrogic/banglaclaw/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "@banglaclaw/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "banglaclaw": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-skills.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@entrogic-net/agent": "workspace:*",
    "@entrogic-net/agents": "workspace:*",
    "@entrogic-net/auth": "workspace:*",
    "@entrogic-net/channels": "workspace:*",
    "@entrogic-net/gateway": "workspace:*",
    "@entrogic-net/knowledge": "workspace:*",
    "@entrogic-net/mcp": "workspace:*",
    "@entrogic-net/observability": "workspace:*",
    "@entrogic-net/plugin-sdk": "workspace:*",
    "@entrogic-net/providers": "workspace:*",
    "@entrogic-net/session": "workspace:*",
    "@entrogic-net/shared": "workspace:*",
    "@entrogic-net/skills": "workspace:*",
    "@entrogic-net/storage": "workspace:*",
    "@entrogic-net/tools": "workspace:*",
    "@entrogic-net/workspace": "workspace:*",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "hono": "^4.13.9",
    "ink": "^7.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.3.0",
    "string-width": "^8.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0"
  }
}
